# Indexer Service Configuration

# Service settings
INDEXER_HOST=localhost
INDEXER_PORT=8002

# OpenSearch settings
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=documents
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
# OPENSEARCH_AUTH=username:password  # Optional authentication

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text:v1.5

# Document processing settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50

# Upload settings
UPLOAD_DIRECTORY=./uploads
ALLOWED_EXTENSIONS=pdf,txt,docx,xlsx,csv,md

# Access control
DEFAULT_ACCESS_LEVEL=user
VALID_ACCESS_LEVELS=administrator,user,guest

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO